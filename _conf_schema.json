{
  "backend": {
    "type": "string",
    "description": "当前服务",
    "hint": "本地 API 与官方 API 分别保存连接设置。",
    "default": "local",
    "options": [
      "local",
      "cloud"
    ]
  },
  "local": {
    "type": "object",
    "description": "本地 API",
    "hint": "兼容开源服务及启用 Bearer 鉴权的部署。",
    "items": {
      "base_url": {
        "type": "string",
        "description": "服务地址",
        "hint": "支持根地址或 /v1，保留反向代理路径前缀。",
        "default": "http://127.0.0.1:7860"
      },
      "api_key": {
        "type": "string",
        "description": "API Key",
        "hint": "仅填写密钥本身。留空用于本地无鉴权服务。",
        "default": "",
        "secret": true
      },
      "mode": {
        "type": "string",
        "description": "合成模式",
        "hint": "reference 需要参考录音和准确文字稿；design 需要声音描述。",
        "default": "reference",
        "options": [
          "reference",
          "design",
          "plain"
        ]
      },
      "reference_id": {
        "type": "string",
        "description": "默认参考录音 ID",
        "hint": "在 BreezeTTS 工作台上传录音并选择默认音色。",
        "default": ""
      },
      "instruction": {
        "type": "text",
        "description": "声音 / 语气描述",
        "hint": "声音设计时填写声线特征；参考音色模式下控制语气。",
        "default": ""
      },
      "cfg_scale": {
        "type": "float",
        "description": "CFG 强度",
        "hint": "普通朗读或纯音色复刻建议 1，带指令可尝试 4。",
        "default": 1.0
      },
      "seed": {
        "type": "int",
        "description": "随机种子",
        "hint": "同样输入与种子有助于复现声音。",
        "default": 42
      }
    }
  },
  "cloud": {
    "type": "object",
    "description": "BreezeBlue 官方 API",
    "hint": "需要官方 API Key 与已保存的音色 ID。",
    "items": {
      "base_url": {
        "type": "string",
        "description": "服务地址",
        "hint": "支持根地址或 /v1，保留反向代理路径前缀。",
        "default": "https://api.breeze.blue/v1"
      },
      "api_key": {
        "type": "string",
        "description": "API Key",
        "hint": "仅填写密钥本身。留空用于本地无鉴权服务。",
        "default": "",
        "secret": true
      },
      "voice_id": {
        "type": "string",
        "description": "官方音色 ID",
        "hint": "在工作台同步并选择官方音色，也可手动填写。",
        "default": ""
      },
      "model_id": {
        "type": "string",
        "description": "模型 ID",
        "hint": "留空由官方自动选择，也可在工作台连接检查后选择。",
        "default": ""
      },
      "language_code": {
        "type": "string",
        "description": "语言代码",
        "hint": "留空自动识别，或使用 zh、en、ja 等两位代码。",
        "default": ""
      },
      "instructions": {
        "type": "text",
        "description": "表演指令",
        "hint": "建议使用与合成文字相同的语言描述语气和情绪。",
        "default": ""
      },
      "guidance_scale": {
        "type": "float",
        "description": "指导强度",
        "hint": "1–10，带表演指令时可尝试 4。",
        "default": 1.0
      },
      "speed": {
        "type": "float",
        "description": "语速",
        "hint": "官方语速倍率，0.5–2。",
        "default": 1.0
      },
      "volume": {
        "type": "float",
        "description": "音量",
        "hint": "官方线性音量倍率，0.01–2。",
        "default": 1.0
      },
      "speaker_boost": {
        "type": "bool",
        "description": "增强音色相似度",
        "hint": "官方 use_speaker_boost 参数。",
        "default": false
      },
      "output_format": {
        "type": "string",
        "description": "输出格式",
        "hint": "本地 PCM 自动封装 WAV；此处仅控制官方输出。",
        "default": "wav",
        "options": [
          "aac",
          "aac_24000_128",
          "flac",
          "flac_24000",
          "mp3",
          "mp3_24000_128",
          "mp3_24000_160",
          "mp3_24000_64",
          "mp3_24000_96",
          "opus",
          "pcm",
          "pcm_24000",
          "wav",
          "wav_24000"
        ]
      },
      "delivery": {
        "type": "string",
        "description": "交付方式",
        "hint": "sync 同步音频；stream 接收完整流；async 轮询后台任务。",
        "default": "sync",
        "options": [
          "sync",
          "stream",
          "async"
        ]
      }
    }
  },
  "behavior": {
    "type": "object",
    "description": "聊天与运行设置",
    "hint": "聊天命令、工具、自动语音及数据保留。",
    "items": {
      "auto_tts": {
        "type": "bool",
        "description": "随机语音",
        "hint": "每轮按概率邀请模型选取一小段朗读，与自主语音共享去重状态。",
        "default": false
      },
      "trigger_probability": {
        "type": "int",
        "description": "随机触发概率（%）",
        "hint": "0–100，每轮只抽取一次；命中后由模型选择适合朗读的片段。",
        "default": 20
      },
      "private_trigger_probability": {
        "type": "int",
        "description": "私聊随机触发概率（%）",
        "hint": "-1 跟随默认概率，0–100 单独设置；仅控制随机语音。",
        "default": -1
      },
      "group_trigger_probability": {
        "type": "int",
        "description": "群聊随机触发概率（%）",
        "hint": "-1 跟随默认概率，0–100 单独设置；仅控制随机语音。",
        "default": -1
      },
      "min_interval_seconds": {
        "type": "int",
        "description": "会话语音最小间隔（秒）",
        "hint": "0–3600，随机语音和 LLM 工具共享间隔；同轮内的不同片段可连续发送。",
        "default": 90
      },
      "keep_text": {
        "type": "bool",
        "description": "保留朗读片段文字",
        "hint": "语音与对应文字一起发送，其余文字保持原位。",
        "default": true
      },
      "tool_enabled": {
        "type": "bool",
        "description": "LLM 自主语音",
        "hint": "模型可按聊天语境或用户要求调用 breeze_tts，选择需要朗读的片段。",
        "default": true
      },
      "max_characters": {
        "type": "int",
        "description": "单次文字上限",
        "hint": "1–2000，官方默认账号上限 1000，提升前请确认账户权限。",
        "default": 1000
      },
      "timeout": {
        "type": "int",
        "description": "合成总超时（秒）",
        "hint": "包含插件排队、官方后台任务轮询和音频下载。",
        "default": 600
      },
      "history_limit": {
        "type": "int",
        "description": "成品 / 预览保留数量",
        "hint": "1–200；参考录音最多 100 条，需手动删除。",
        "default": 50
      },
      "history_max_mb": {
        "type": "int",
        "description": "成品 / 预览总容量（MiB）",
        "hint": "64–4096，达到数量或容量上限时清理最旧成品；参考录音单独保留。",
        "default": 256
      }
    }
  }
}
